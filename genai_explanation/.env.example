
# Optional: Part 4 works without an LLM (template-based fallback).
# To enable an LLM later, copy this file to ".env" and fill in your values.
# NEVER commit ".env".

# Leave empty for fallback, or use: openai_compatible
SENTINEL_LLM_PROVIDER=

SENTINEL_LLM_API_KEY=
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_MODEL=

# Seconds to wait before falling back (default 20)
SENTINEL_LLM_TIMEOUT=20
