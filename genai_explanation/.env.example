# OPTIONAL. Part 4 works without any of these (template-based fallback).
# To enable a real LLM later: copy this file to ".env" in the same folder and fill it in.
# NEVER commit ".env" (genai_explanation/.gitignore already excludes it).
#
# SENTINEL_LLM_PROVIDER: leave empty for the fallback, or use: openai_compatible
SENTINEL_LLM_PROVIDER=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_MODEL=
SENTINEL_LLM_TIMEOUT=20