# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit ".env". It is listed in .gitignore.
# If SENTINEL_LLM_API_KEY is empty, Sentinel uses the rule-based fallback.

SENTINEL_LLM_API_KEY=
# Any OpenAI-compatible provider. Check your provider's documentation for the
# exact base URL and a current model name.
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_MODEL=
# Seconds to wait for the LLM before falling back (optional, default 20)
SENTINEL_LLM_TIMEOUT=20